# -----------------------------------------------------------------------------
# Copy this file to `.env.local` for local development.
# Never commit `.env.local`; it is already covered by .gitignore.
# -----------------------------------------------------------------------------

# --- Optional: 3D athlete model -------------------------------------------------
# Absolute URL of a GLB model of Ahmed Said Shafik.
# Leave empty in stage one: the app then renders the built-in stylised athlete
# and makes NO request for a model file.
# NEXT_PUBLIC_ATHLETE_MODEL_URL=https://example.com/models/ahmed-shafik.glb

# --- Contact form delivery (server-side only, stage two) -----------------------
# The contact form stays visibly unavailable until all three are set.
# Keep these out of any NEXT_PUBLIC_ variable: they must never reach the browser.
# CONTACT_PROVIDER=resend
# CONTACT_API_KEY=
# CONTACT_TO_EMAIL=